{
  "name": "nexora",
  "version": "1.0.7",
  "description": "NEXORA Browser – AI-powered browser by HISHAN KHAN",
  "productName": "NEXORA Browser",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=& electron .",
    "dev": "set ELECTRON_RUN_AS_NODE=& electron . --dev",
    "build": "npx @electron/packager . NEXORA --platform=win32 --arch=x64 --out=../dist --overwrite --no-asar --icon=assets/nexora-icon.ico --ignore \"(node_modules/electron/dist|node_modules/@electron|node_modules/\\.cache|dist_new|dist_v2|dist_v2_COPY|\\$null$|player-script\\.js|BMW1\\.png|crash\\.log|test_download|launch\\.bat|start\\.bat|\\.packagerignore$)\" --version-string.ProductName=\"NEXORA Browser\" --version-string.CompanyName=\"NEXORA\" --version-string.FileDescription=\"NEXORA Browser\" --version-string.OriginalFilename=\"NEXORA.exe\""
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^42.3.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@cliqz/adblocker-extended-selectors": "^1.34.0",
    "@distube/ytdl-core": "^4.16.12",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.5.18",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.1",
    "ytdl-core": "^4.11.5"
  }
}
