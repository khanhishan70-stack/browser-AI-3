# NEXORA Electron configuration — copy to ".env" and fill in YOUR values.
# ".env" is git-ignored and never pushed. ".env.example" ships with blanks only.

# Google OAuth client ID for built-in Sign in with Google (public client + PKCE,
# no secret needed). Get one at https://console.cloud.google.com/apis/credentials
# Leave blank to disable built-in Google sign-in.
NEO_GOOGLE_CLIENT_ID=

# Future provider keys go here, e.g.:
# NEXORA_EXTRA_API_KEY=
