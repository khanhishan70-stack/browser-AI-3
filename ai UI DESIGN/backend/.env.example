# NEXORA backend configuration — copy to ".env" and fill in YOUR values.
# ".env" is git-ignored and never pushed. ".env.example" ships with blanks only.
#
#   copy ".env.example" ".env"   (PowerShell)
#   copy .env.example .env       (cmd)

# Groq AI key (required) — get one at https://console.groq.com
GROQ_API_KEY=

# Assistant wake name (optional)
ASSISTANT_NAME=ESTA

# Local admin password used by owner-only endpoints (optional, min 4 chars)
PASSWORD=

# Owner phone numbers for WhatsApp quick actions (optional, E.164 format)
MOM_NUMBER=
PHONE_NUMBER=

# WhatsApp call automation tuning (optional)
MOM_WHATSAPP_CALL_LINK=
WHATSAPP_CALL_DELAY=8
WHATSAPP_CALL_X=
WHATSAPP_CALL_Y=
WHATSAPP_CALL_OFFSET_X=132
WHATSAPP_CALL_OFFSET_Y=56

# Offline model tuning (optional)
OFFLINE_MAX_TOKENS=512
