# Groq API Key - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Assistant Settings
ASSISTANT_NAME=sunday
PASSWORD=your_password_here
MOM_NUMBER=
PHONE_NUMBER=
MOM_WHATSAPP_CALL_LINK=

# Mouse "task start" animation before desktop actions (1=on, 0=off). Optional radius in pixels.
# CURSOR_TASK_ANIMATION=1
# CURSOR_TASK_RADIUS=76

# Server Settings
FLASK_ENV=development
FLASK_DEBUG=True
